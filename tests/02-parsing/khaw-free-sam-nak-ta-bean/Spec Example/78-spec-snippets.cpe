data IntList = EmptyIntList | ConsIntList Int IntList
data List a = Empty | Cons a (List a)

data Either a b = Left a | Right b
data Logged a = Log String a
data Box a = Box a
data Even = Zero | ESucc Odd
data Odd = OSucc Even
data Map domain codomain = ...
type Endomap s = Map s s

def isEven (x : Integer) : Bool =
  if x == 0 then True else if x < 0 then isEven (-x) else isOdd (x-1)

def isOdd (x : Integer) : Bool =
  if x == 0 then False else if x < 0 then isOdd (-x) else isEven (x-1)

def x : Integer = y + 1  # illegal: forward reference
def y : Integer = x - 1

def hofstadter (n : Integer) : (Integer, Integer) =
  let f (n : Integer) : Integer =
        if n == 0 then 1 else n - m (f (n-1))
  and m (n : Integer) : Integer =
        if n == 0 then 0 else n - f (m (n-1))
  in (f n, m n)

def bot () : Integer =
  let forever (x : Integer) : Integer = forever x
  in forever 42

let partMap = map parseInt
in partMap ("261" :: "406" :: [])

match l with
| [] -> True
| x1::x2::xs -> x1 == x2
| hd::tl -> False
