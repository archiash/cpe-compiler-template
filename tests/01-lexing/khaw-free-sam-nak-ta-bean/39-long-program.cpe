# Fibonacci and list utilities (spec-conformant syntax)
import prelude
import utils as u

data List a = Nil | Cons a (List a)
type Pair a = (a, a)

def fib (n : Integer) : Integer =
  if n <= 1 then n
  else fib (n - 1) + fib (n - 2)

def length (xs : [a]) : Integer =
  match xs with
  | [] -> 0
  | x::rest -> 1 + length rest

(* higher-order
   functions *)
def map (f : a -> b) (xs : [a]) : [b] = match xs with
  | [] -> []
  | y::ys -> f y :: map f ys

def double (n : Integer) : Integer = (\ (x : Integer) : Integer => x * 2) n
def greet (name : String) : String = "Hello, " ++ name ++ "!\n"
def isVowel (c : Char) : Bool = c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u'
def isNewline (c : Char) : Bool = c == '\n' || c == '\r'
def avg (a : Double) (b : Double) : Double = (a + b) / 2.0
def sumSq (a : Integer) (b : Integer) : Integer =
  let sq (x : Integer) : Integer = x * x
  and one = 1
  in sq a + sq b + one
def ne (a : Integer) (b : Integer) : Bool = a != b
def main (arg : [String]) : String = u!unwords . map greet $ arg
